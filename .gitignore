# --- Large / external content (never upload) ---------------------------------
# 21cmFAST lightcone HDF5 files and every derived cache.
# Datasets live in <work>/data/{data,compressed}/ -- see dataset/paths.py.
# Nothing large belongs in the project root; /*.h5 catches strays.
data/
trainset*.h5*
/*.h5
zre_targets.h5
zre_inputs.h5
xhi_band*.h5

# Local neuraloperator checkout — third-party library with its own git history.
# Install via conda/pip, or clone https://github.com/neuraloperator/neuraloperator
# into ./neuraloperator/ to use the vendored source path.
neuraloperator/

# Trained model artifacts (regenerable by re-running training)
checkpoints/
checkpoints_3d/

# Rendered figures from visualize{,_3d}.py (regenerable from checkpoints)
figures/

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.venv/
env/

# --- OS / editor -------------------------------------------------------------
.DS_Store

# --- Additions 2026-09-15: close the gaps that .gitignore did not cover ------
# checkpoint-archive/ (45 GB) was only excluded via .git/info/exclude, which is
# local to this clone and invisible to anyone else who clones the repo.
checkpoint-archive/
checkpoints*/

# Slurm job logs: regenerable, high churn, and they leak absolute cluster paths.
logs/
*.out
*.err
!slurm/*.sbatch

# Any stray heavy artifact, wherever it lands. Model weights, caches and array
# dumps are all regenerable from code + raw data; none belong in git.
*.h5
*.hdf5
*.pt
*.pth
*.ckpt
*.npz
*.npy

# Temporary staging views built for cache/pilot builds (symlink farms).
**/_pilot_stage/
**/_multifield_stage/
**/_eval_snapshot*/

# Dashboard runtime state (per-user, not project configuration).
dashboard/serve-*.log
dashboard/__pycache__/
